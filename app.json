{
  "expo": {
    "name": "PropertyLoop",
    "slug": "propertyloop-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "propertyloopmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/9f9d95ab-7568-41be-ad3a-101f1ca02a0b"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.propertyloop.app",
      "buildNumber": "11",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ng.propertyloop.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 9,
      "permissions": []
    },
    "androidStatusBar": {
      "backgroundColor": "#071c12",
      "barStyle": "light-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-foreground.png",
          "imageWidth": 175,
          "resizeMode": "contain",
          "backgroundColor": "#071c12",
          "dark": {
            "image": "./assets/images/adaptive-foreground.png",
            "backgroundColor": "#071c12"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow PropertyLoop to use Face ID to protect permanent account actions."
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "PropertyLoop needs access to your photos so you can choose a profile picture, upload property images for your listings, attach photos of completed work or a job dispute, and send photo attachments in chat.",
          "cameraPermission": "PropertyLoop uses your camera only so you can take a profile picture instead of choosing one from your photos. It is never used for facial recognition or any other biometric processing.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f9d95ab-7568-41be-ad3a-101f1ca02a0b"
      }
    },
    "owner": "techprooo"
  }
}
